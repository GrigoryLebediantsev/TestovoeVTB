# Банк и период извлечения
EXTRACTION__BANK=demo_bank
EXTRACTION__PERIOD_FROM=2026-05-01
EXTRACTION__PERIOD_TO=2026-06-30

# Демо-банк (локальный учебный кабинет: python -m demo_bank --port 8000)
DEMO_BANK__BASE_URL=http://127.0.0.1:8000
DEMO_BANK__LOGIN_TIMEOUT_SECONDS=300
DEMO_BANK__ACTION_TIMEOUT_SECONDS=15

# Браузер: launch — собственный с окном (временный профиль удаляется после работы), cdp — уже открытый Chrome клиента
BROWSER__MODE=launch
# BROWSER__PROFILE_DIR=/path/to/persistent/profile
BROWSER__CDP_URL=http://127.0.0.1:9222
# Сколько ждать решения клиента на странице согласия
BROWSER__CONSENT_TIMEOUT_SECONDS=300

# Папка результатов
STORAGE__OUTPUT_DIR=output

# Логирование: PRETTY_CONSOLE=true — цветной вывод, false — JSON
LOGGER__APP_NAME=bank-statement
LOGGER__LEVEL=INFO
LOGGER__PRETTY_CONSOLE=true
